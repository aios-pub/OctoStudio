                draw_bg +: {color: #xffffff color_hover: #xffffff color_focus: #xffffff color_empty: #xf5e6d2 border_radius: 8.0}
                draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: secondary color_empty_hover: secondary}}
            source_label := Label{width: Fill text: "文字稿 / 原文" draw_text.color: secondary draw_text.text_style.font_size: 10}
            source_input := TextInput{width: Fill height: 180 empty_text: "粘贴视频文字稿 / 原文 / 详细描述…"
                draw_bg +: {color: #xffffff color_hover: #xffffff color_focus: #xffffff color_empty: #xf5e6d2 border_radius: 8.0}
                draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: secondary color_empty_hover: secondary}}
            model_label := Label{width: Fill text: "" draw_text.color: secondary draw_text.text_style.font_size: 11}
            }
            View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                ButtonFlat{text: "返回广场" height: 40 padding: Inset{left: 18 right: 18} on_click: || goto(0)
                    draw_bg +: {color: chip_bg color_hover: warm_hover border_radius: 20.0 border_size: 0.0}
                    draw_text +: {color: ink color_hover: ink}}
                compose_btn := ButtonFlat{text: "进入创作" height: 40 padding: Inset{left: 18 right: 18} on_click: || { current_source = ui.source_input.text(); current_reference = ui.reference_input.text(); plan_kind = ""; goto(2) }
                    draw_bg +: {color: accent color_hover: #xff8866 border_radius: 20.0 border_size: 0.0}
                    draw_text +: {color: #xffffff color_hover: #xffffff}}
                generate_btn := ButtonFlat{text: "生成" height: 40 padding: Inset{left: 18 right: 18} on_click: || { current_prompt = ui.prompt_input.text(); current_source = ui.source_input.text(); ask_scenario() }
                    draw_bg +: {color: (if busy {secondary} else {accent}) color_hover: (if busy {secondary} else {#xff8866}) border_radius: 20.0 border_size: 0.0}
                    draw_text +: {color: #xffffff color_hover: #xffffff}}
            }
        }

        studio_view := View{width: Fill height: Fill flow: Down spacing: 8 visible: (mode == 2)
            Label{text: "创作工坊" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 20}}
            studio_scroll := ScrollYView{width: Fill height: Fill flow: Down spacing: 8
            ScrollXView{width: Fill height: Fit flow: Right spacing: 6
                for i in 8 {
                    let styles = ["改写" "翻译" "总结" "评论" "润色" "续写" "扩写" "小红书体"]
                    let s = styles[i]
                    ButtonFlat{text: s height: 32 padding: Inset{left: 12 right: 12}
                        on_click: || current_style = s
                        draw_bg +: {color: (if current_style == s {accent} else {chip_bg}) color_hover: (if current_style == s {#xff8866} else {warm_hover}) border_radius: 16.0 border_size: 0.0}
                        draw_text +: {color: (if current_style == s {#xffffff} else {ink}) color_hover: (if current_style == s {#xffffff} else {ink})}}
                }
            }
            ButtonFlat{text: (if busy {"创作中…"} else {"AI 创作"}) height: 40 padding: Inset{left: 18 right: 18} on_click: || ask_ai()
                draw_bg +: {color: (if busy {secondary} else {accent}) color_hover: (if busy {secondary} else {#xff8866}) border_radius: 20.0 border_size: 0.0}
                draw_text +: {color: #xffffff color_hover: #xffffff}}
            ButtonFlat{text: "重试" height: 40 padding: Inset{left: 18 right: 18} on_click: || ask_ai() visible: (!busy)
                draw_bg +: {color: chip_bg color_hover: warm_hover border_radius: 20.0 border_size: 0.0}
                draw_text +: {color: ink color_hover: ink}}
            title_input := TextInput{width: Fill height: 38 empty_text: current_title
                draw_bg +: {color: #xffffff color_hover: #xffffff color_focus: #xffffff color_empty: #xf5e6d2 border_radius: 8.0}
                draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: secondary color_empty_hover: secondary}}
            reference_label := Label{text: "参考图" draw_text.color: secondary draw_text.text_style.font_size: 11}
            reference_image := Image{width: Fill height: 140 fit: ImageFit.CropToFill visible: false}
            reference_caption := Label{width: Fill text: "" draw_text.color: secondary draw_text.text_style.font_size: 11}
            Label{text: "原文" draw_text.color: secondary draw_text.text_style.font_size: 11}
            ScrollYView{width: Fill height: 90 flow: Down padding: Inset{left: 10 right: 10 top: 8 bottom: 8}
                draw_bg.color: card_bg draw_bg.border_radius: 8.0
                source_preview := Label{width: Fill text: current_source draw_text.color: ink draw_text.text_style.font_size: 13}}
            Label{text: "成稿(可手动修改)" draw_text.color: secondary draw_text.text_style.font_size: 11}
            content_input := TextInput{width: Fill height: 240 empty_text: "点 AI 创作或直接在此写"
                draw_bg +: {color: #xffffff color_hover: #xffffff color_focus: #xffffff color_empty: #xf5e6d2 border_radius: 8.0}
                draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: secondary color_empty_hover: secondary}}
            Label{width: Fill text: ("字数: 原文 " + word_count(current_source).to_string() + " · 成稿 " + word_count(current_content).to_string()) draw_text.color: secondary draw_text.text_style.font_size: 11}
            }
            View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                ButtonFlat{text: "返回广场" height: 40 padding: Inset{left: 18 right: 18} on_click: || goto(0)
                    draw_bg +: {color: chip_bg color_hover: warm_hover border_radius: 20.0 border_size: 0.0}
                    draw_text +: {color: ink color_hover: ink}}
                ButtonFlat{text: "保存作品" height: 40 padding: Inset{left: 18 right: 18} on_click: || { let t = ui.title_input.text(); current_title = (if t == "" {"未命名作品"} else {t}); current_content = ui.content_input.text(); upsert_and_save(); goto(0) }
                    draw_bg +: {color: accent color_hover: #xff8866 border_radius: 20.0 border_size: 0.0}
                    draw_text +: {color: #xffffff color_hover: #xffffff}}
            }
        }

        plan_view := View{width: Fill height: Fill flow: Down spacing: 8 visible: (mode == 3)
            View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                plan_kind_label := Label{width: Fill text: "" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 18}}
                images_btn := ButtonFlat{text: "配图:开" height: 28 padding: Inset{left: 10 right: 10} on_click: || toggle_images()
                    draw_bg +: {color: chip_bg color_hover: warm_hover border_radius: 14.0 border_size: 0.0}
                    draw_text +: {color: secondary color_hover: ink }
