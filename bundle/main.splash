                        }
                        if hist_arr.len() > 0 {
                            View{width: Fill height: Fit flow: Right spacing: 6 align: Align{y: 0.5}
                                ButtonFlat{text: (if (history_open_id == w["id"]) {"收起历史"} else {history_summary(hist_arr)}) height: 24 padding: Inset{left: 8 right: 8}
                                    on_click: || toggle_history(w["id"])
