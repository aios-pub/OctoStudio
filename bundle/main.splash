                draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: secondary color_empty_hover: secondary}}
            plan_hint := Label{width: Fill text: "" draw_text.color: secondary draw_text.text_style.font_size: 11}
            plan_content_label := Label{width: Fill text: "笔记正文(可编辑)" draw_text.color: secondary draw_text.text_style.font_size: 10}
            plan_content_input := TextInput{width: Fill height: 120 empty_text: "笔记正文"
                draw_bg +: {color: #xffffff color_hover: #xffffff color_focus: #xffffff color_empty: #xf5e6d2 border_radius: 8.0}
                draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: secondary color_empty_hover: secondary}}
            comp_card := RoundedView{width: Fill height: Fit flow: Down padding: Inset{top: 10 bottom: 10 left: 12 right: 12} spacing: 4 visible: false
                draw_bg.color: card_bg draw_bg.border_radius: 8.0
                comp_head := Label{width: Fill text: "" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 13}}
                comp_body := Label{width: Fill text: "" draw_text.color: ink draw_text.text_style.font_size: 12}
            }
            plan_list := ScrollYView{width: Fill height: Fill flow: Down spacing: 10
                plan_inner := View{width: Fill height: Fit flow: Down spacing: 10 on_render: || {
                if current_plan_items.len() == 0 {
                    Label{text: "尚无内容 — 点下方「新增一条」,或回录入页生成" draw_text.color: secondary draw_text.text_style.font_size: 12}
                }
                for i in 16 {
                    if i < current_plan_items.len() {
                    let it = current_plan_items[i]
                    let idx = i + 1
                    RoundedView{width: Fill height: Fit flow: Down padding: Inset{top: 10 bottom: 10 left: 12 right: 12} spacing: 6
                        draw_bg.color: card_bg draw_bg.border_radius: 8.0
                        View{width: Fill height: Fit flow: Right spacing: 6 align: Align{y: 0.5}
                            Label{width: Fill text: ("第 " + idx.to_string() + " 条") draw_text.color: secondary draw_text.text_style.font_size: 10}
                            ButtonFlat{text: "编辑" height: 24 padding: Inset{left: 8 right: 8} on_click: || start_edit_item(it)
                                draw_bg +: {color: chip_bg color_hover: warm_hover border_radius: 12.0 border_size: 0.0}
                                draw_text +: {color: ink color_hover: ink }
                                draw_text.text_style.font_size: 9}
                            ButtonFlat{text: "上移" height: 24 padding: Inset{left: 8 right: 8} on_click: || item_move_up(it)
                                draw_bg +: {color: chip_bg color_hover: warm_hover border_radius: 12.0 border_size: 0.0}
                                draw_text +: {color: secondary color_hover: ink }
                                draw_text.text_style.font_size: 9}
                            ButtonFlat{text: "下移" height: 24 padding: Inset{left: 8 right: 8} on_click: || item_move_down(it)
                                draw_bg +: {color: chip_bg color_hover: warm_hover border_radius: 12.0 border_size: 0.0}
                                draw_text +: {color: secondary color_hover: ink }
                                draw_text.text_style.font_size: 9}
                            ButtonFlat{text: "删除" height: 24 padding: Inset{left: 8 right: 8} on_click: || item_delete_item(it)
                                draw_bg +: {color: chip_bg color_hover: warm_hover border_radius: 12.0 border_size: 0.0}
                                draw_text +: {color: danger color_hover: danger }
                                draw_text.text_style.font_size: 9}
                        }
                        if editing_k == it["_k"] {
                            RoundedView{width: Fill height: Fit flow: Down spacing: 4 padding: Inset{top: 8 bottom: 8 left: 10 right: 10}
                                draw_bg.color: #xffe9d6 draw_bg.border_radius: 6.0
                                View{width: Fill height: Fit flow: Right spacing: 6 align: Align{y: 0.5}
                                    Label{width: Fill text: "编辑此条(留空 = 不修改)" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 11}}
                                    ButtonFlat{text: "写入" height: 26 padding: Inset{left: 10 right: 10} on_click: || apply_edit()
                                        draw_bg +: {color: accent color_hover: #xff8866 border_radius: 13.0 border_size: 0.0}
                                        draw_text +: {color: #xffffff color_hover: #xffffff}}
                                    ButtonFlat{text: "取消" height: 26 padding: Inset{left: 10 right: 10} on_click: || cancel_edit()
                                        draw_bg +: {color: chip_bg color_hover: warm_hover border_radius: 13.0 border_size: 0.0}
                                        draw_text +: {color: ink color_hover: ink}}
                                }
                                let efields = item_fields(plan_kind)
                                let en = efields.len()
                                if en > 0 {
                                    let ef = efields[0]
                                    Label{width: Fill text: (ef["label"] + "(原: " + sval(it[ef["key"]]) + ")") draw_text.color: secondary draw_text.text_style.font_size: 9}
                                    edit1_input := TextInput{width: Fill height: 32 empty_text: "留空则不修改"
                                        draw_bg +: {color: #xffffff color_hover: #xffffff color_focus: #xffffff border_radius: 5.0}
                                        draw_text +: {color: ink color_hover: ink color_focus: ink}}
                                }
                                if en > 1 {
                                    let ef = efields[1]
                                    Label{width: Fill text: (ef["label"] + "(原: " + sval(it[ef["key"]]) + ")") draw_text.color: secondary draw_text.text_style.font_size: 9}
                                    edit2_input := TextInput{width: Fill height: 32 empty_text: "留空则不修改"
                                        draw_bg +: {color: #xffffff color_hover: #xffffff color_focus: #xffffff border_radius: 5.0}
                                        draw_text +: {color: ink color_hover: ink color_focus: ink}}
                                }
                                if en > 2 {
                                    let ef = efields[2]
                                    Label{width: Fill text: (ef["label"] + "(原: " + sval(it[ef["key"]]) + ")") draw_text.color: secondary draw_text.text_style.font_size: 9}
                                    edit3_input := TextInput{width: Fill height: 32 empty_text: "留空则不修改"
                                        draw_bg +: {color: #xffffff color_hover: #xffffff color_focus: #xffffff border_radius: 5.0}
                                        draw_text +: {color: ink color_hover: ink color_focus: ink}}
                                }
                                if en > 3 {
                                    let ef = efields[3]
                                    Label{width: Fill text: (ef["label"] + "(原: " + sval(it[ef["key"]]) + ")") draw_text.color: secondary draw_text.text_style.font_size: 9}
                                    edit4_input := TextInput{width: Fill height: 32 empty_text: "留空则不修改"
                                        draw_bg +: {color: #xffffff color_hover: #xffffff color_focus: #xffffff border_radius: 5.0}
                                        draw_text +: {color: ink color_hover: ink color_focus: ink}}
                                }
                                if en > 4 {
                                    let ef = efields[4]
                                    Label{width: Fill text: (ef["label"] + "(原: " + sval(it[ef["key"]]) + ")") draw_text.color: secondary draw_text.text_style.font_size: 9}
                                    edit5_input := TextInput{width: Fill height: 32 empty_text: "留空则不修改"
                                        draw_bg +: {color: #xffffff color_hover: #xffffff color_focus: #xffffff border_radius: 5.0}
                                        draw_text +: {color: ink color_hover: ink color_focus: ink}}
                                }
                                if en > 5 {
                                    let ef = efields[5]
                                    Label{width: Fill text: (ef["label"] + "(原: " + sval(it[ef["key"]]) + ")") draw_text.color: secondary draw_text.text_style.font_size: 9}
                                    edit6_input := TextInput{width: Fill height: 32 empty_text: "留空则不修改"
                                        draw_bg +: {color: #xffffff color_hover: #xffffff color_focus: #xffffff border_radius: 5.0}
                                        draw_text +: {color: ink color_hover: ink color_focus: ink}}
                                }
                            }
                        }
                        let fields = item_fields(plan_kind)
                        for f in fields {
                            Label{width: Fill text: (f["label"] + ": " + sval(it[f["key"]])) draw_text.color: ink draw_text.text_style.font_size: 11}
                        }
                        if images_on {
                            let p = img_prompt_of(plan_kind, it)
                            if p != "" {
                                Label{width: Fill text: "AI 配图(可选增强 · 离线自动忽略)" draw_text.color: secondary draw_text.text_style.font_size: 9}
                                Image{width: Fill height: 110 fit: ImageFit.CropToFill src: http_resource(img_url(p, img_w(plan_kind), img_h(plan_kind), seed_of(it)))}
                            }
                        }
                    }
                    }
                }
                }}
            }
            plan_word := Label{width: Fill text: "" draw_text.color: secondary draw_text.text_style.font_size: 11}
            View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                ButtonFlat{text: "返回广场" height: 40 padding: Inset{left: 14 right: 14} on_click: || goto(0)
                    draw_bg +: {color: chip_bg color_hover: warm_hover border_radius: 20.0 border_size: 0.0}
                    draw_text +: {color: ink color_hover: ink}}
                ButtonFlat{text: "保存作品" height: 40 padding: Inset{left: 14 right: 14} on_click: || { let t = ui.plan_title_input.text(); if t != "" { current_title = t; current_plan_title = t }; if plan_kind == "xhs" { current_content = ui.plan_content_input.text() }; upsert_and_save(); goto(0) }
                    draw_bg +: {color: accent color_hover: #xff8866 border_radius: 20.0 border_size: 0.0}
                    draw_text +: {color: #xffffff color_hover: #xffffff}}
                ButtonFlat{text: "导出" height: 40 padding: Inset{left: 14 right: 14} on_click: || { let t = ui.plan_title_input.text(); if t != "" { current_title = t; current_plan_title = t }; goto(4) }
                    draw_bg +: {color: accent color_hover: #xff8866 border_radius: 20.0 border_size: 0.0}
                    draw_text +: {color: #xffffff color_hover: #xffffff}}
            }
            View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                ButtonFlat{text: "+ 新增一条" height: 36 padding: Inset{left: 12 right: 12} on_click: || item_add()
                    draw_bg +: {color: chip_bg color_hover: warm_hover border_radius: 18.0 border_size: 0.0}
                    draw_text +: {color: ink color_hover: ink}}
                comp_btn := ButtonFlat{text: "AI 合成建议" height: 36 padding: Inset{left: 14 right: 14} on_click: || ask_composition() visible: false
                    draw_bg +: {color: chip_bg color_hover: warm_hover border_radius: 18.0 border_size: 0.0}
                    draw_text +: {color: ink color_hover: ink}}
                tpl_btn := ButtonFlat{text: "存为分镜模板" height: 36 padding: Inset{left: 14 right: 14} on_click: || teardown_to_template() visible: false
                    draw_bg +: {color: chip_bg color_hover: warm_hover border_radius: 18.0 border_size: 0.0}
                    draw_text +: {color: ink color_hover: ink}}
            }
        }

        export_view := View{width: Fill height: Fill flow: Down spacing: 10 visible: (mode == 4)
            Label{text: "导出" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 20}}
            export_hint := Label{width: Fill text: "" draw_text.color: secondary draw_text.text_style.font_size: 11}
            export_formats := ScrollXView{width: Fill height: Fit flow: Right spacing: 6 on_render: || {
                let fs = kind_formats(plan_kind)
                for f in fs {
                    ButtonFlat{text: f["label"] height: 30 padding: Inset{left: 8 right: 8}
                        on_click: || { plan_format = f["id"]; ui.export_body.set_text(render_plan_as_text()); ui.export_hint.set_text(format_hint(plan_format)) }
                        draw_bg +: {color: (if plan_format == f["id"] {accent} else {chip_bg}) color_hover: (if plan_format == f["id"] {#xff8866} else {warm_hover}) border_radius: 16.0 border_size: 0.0}
                        draw_text +: {color: (if plan_format == f["id"] {#xffffff} else {ink}) color_hover: (if plan_format == f["id"] {#xffffff} else {ink}) }
                        draw_text.text_style.font_size: 10}
                }
            }}
            ScrollYView{width: Fill height: Fill flow: Down padding: Inset{left: 14 right: 14 top: 14 bottom: 14} spacing: 12
                draw_bg.color: card_bg draw_bg.border_radius: 10.0
                export_title := Label{width: Fill text: current_title draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 22}}
                export_body := Label{width: Fill text: render_plan_as_text() draw_text.color: ink draw_text.text_style.font_size: 14}
            }
            View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                ButtonFlat{text: "返回广场" height: 40 padding: Inset{left: 18 right: 18} on_click: || goto(0)
                    draw_bg +: {color: chip_bg color_hover: warm_hover border_radius: 20.0 border_size: 0.0}
                    draw_text +: {color: ink color_hover: ink}}
                ButtonFlat{text: "回到编辑" height: 40 padding: Inset{left: 18 right: 18} on_click: || { if plan_kind == "" { goto(2) } else { goto(3) } }
                    draw_bg +: {color: accent color_hover: #xff8866 border_radius: 20.0 border_size: 0.0}
                    draw_text +: {color: #xffffff color_hover: #xffffff}}
            }
        }
    }
}
