                        on_click: || switch_scenario(sc["id"])
                        draw_bg +: {color: (if plan_kind == sc["id"] {accent} else {chip_bg}) color_hover: (if plan_kind == sc["id"] {#xff8866} else {warm_hover}) border_radius: 14.0 border_size: 0.0}
