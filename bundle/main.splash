let plan_kind = ""                   // "" | image | video | ppt | teardown | titles | xhs | script | mindmap | quotes
let plan_format = "markdown"
let current_theme = ""               // 主题 id(文章类场景)
let current_preset = ""              // 视频风格预设 id
let current_composition = nil        // 视频合成建议
let images_on = true                 // 生图增强开关
let editing_k = -1                  // 计划编辑器:正在编辑条目的 _k 键,-1 关闭
let status_detail = ""              // 状态栏副标题:对当前 AI 能力的解释(跨宿主)
let busy = false
let gen_timer = nil                 // 生成看门狗:慢响应超 70s 时复位 busy,避免卡死
let status_text = "就绪"
let studio_inited = false
let model_available = false
let octos_available = false
let search_query = ""
let active_tag = ""
let known_tags = []
