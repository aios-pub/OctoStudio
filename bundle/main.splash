// ---------- 持久化 ----------

fn load_works(){
    if fs.exists("works.json") {
        let v = fs.read("works.json").parse_json()
        if v != nil {
            let normalized = []
            for w in v {
                let fixed = w
                if fixed["prompt"] == nil { fixed += {prompt: ""} }
                if fixed["plan_kind"] == nil { fixed += {plan_kind: ""} }
                if fixed["plan_title"] == nil { fixed += {plan_title: ""} }
                if fixed["plan_sections"] == nil { fixed += {plan_sections: []} }
                if fixed["plan_scenes"] == nil { fixed += {plan_scenes: []} }
                if fixed["plan_summary"] == nil { fixed += {plan_summary: ""} }
                if fixed["plan_items"] == nil { fixed += {plan_items: []} }
                if fixed["theme"] == nil { fixed += {theme: ""} }
                if fixed["composition"] == nil { fixed += {composition: nil} }
                if fixed["tags"] == nil { fixed += {tags: []} }
                if fixed["history"] == nil { fixed += {history: []} }
                if fixed["id"] == nil { fixed += {id: "w-legacy-" + bump_seq().to_string()} }
                if fixed["id"] == "" { fixed += {id: "w-legacy-" + bump_seq().to_string()} }
                normalized.push(fixed)
            }
            works = normalized
        }
    }
    seq = works.len()
}

fn save_works(){
    fs.write("works.json", works.to_json())
}

// ---------- 标签聚合 / 搜索 / AI 历史 ----------

fn rebuild_known_tags(){
    let all = []
    for w in works {
        let ts = w["tags"]
        if ts != nil {
            for t in ts {
                let v = sval(t)
                if v != "" {
                    let seen = false
                    for x in all {
                        if x == v { seen = true }
                    }
                    if !seen { all.push(v) }
                }
            }
        }
    }
    known_tags = all
}

fn set_search(q){
    search_query = q
    ui.works_list.render()
}

fn toggle_tag(t){
    if active_tag == t { active_tag = "" } else { active_tag = t }
    ui.tag_row.render()
    ui.works_list.render()
}

fn toggle_history(id){
    if history_open_id == id { history_open_id = "" } else { history_open_id = id }
    ui.works_list.render()
}

fn filtered_works(){
    let q = search_query
    let t = active_tag
    let out = []
    for w in works {
        if t != "" {
            let ts = w["tags"]
            let has_tag = false
            if ts != nil {
                for tag in ts {
                    if tag == t { has_tag = true }
                }
            }
            if !has_tag { continue }
        }
        if q != "" {
            let title_v = (if w["title"] != nil {w["title"]} else {""})
            let source_v = (if w["source"] != nil {w["source"]} else {""})
            let hit = (title_v.search(q) >= 0)
            if !hit { hit = (source_v.search(q) >= 0) }
            if !hit { continue }
        }
        out.push(w)
    }
    return out
}

fn add_history_entry(prompt, result){
    if current_id == "" { return }
    let h = []
    for w in works {
        if w["id"] == current_id {
            let ex = w["history"]
            if ex != nil { h = ex }
        }
    }
    h.push({prompt: prompt result: sval(result) time: bump_seq()})
    let n = h.len()
    if n > 3 {
        let trimmed = []
        for i in n {
            if i >= n - 3 { trimmed.push(h[i]) }
        }
        h = trimmed
    }
    let kept = []
    let replaced = false
    for w in works {
        if w["id"] == current_id {
            let u = w
            u["history"] = h
            kept.push(u)
            replaced = true
        } else {
            kept.push(w)
        }
    }
    if replaced { works = kept; save_works() }
}

fn history_summary(items){
    let n = items.len()
    if n == 0 { return "尚无 AI 历史" }
    if n == 1 { return "AI 历史 · 1 条" }
    return "AI 历史 · " + n.to_string() + " 条(最多保留 3 条)"
}

fn add_tag_to_current(tag){
    if current_id == "" { return }
    if tag == "" { return }
    let kept = []
    let replaced = false
    for w in works {
        if w["id"] == current_id {
            let u = w
            let ts = u["tags"]
            if ts == nil { ts = [] }
            let seen = false
            for x in ts {
                if x == tag { seen = true }
            }
            if !seen { ts.push(tag) }
            u["tags"] = ts
            kept.push(u)
            replaced = true
        } else {
            kept.push(w)
        }
    }
    if replaced { works = kept; save_works(); rebuild_known_tags() }
}

fn history_lines(items){
    let out = ""
    let n = items.len()
    let start = 0
    if n > 3 { start = n - 3 }
    let idx = 1
    for i in 18 {
        if i + start < n {
            let it = items[i + start]
            let p = sval(it["prompt"])
            let r = sval(it["result"])
            if r.len() > 80 { r = r.substr(0, 80) + "…" }
            out = out + idx.to_string() + ") " + p + " → " + r + "\n"
            idx = idx + 1
        }
    }
    return out
}

fn start_scenario(id){
    plan_kind = id
    current_id = new_id()
    current_title = ""
    current_source = ""
    current_reference = ""
    current_content = ""
    current_style = "改写"
    current_prompt = ""
    current_plan_title = ""
    current_plan_summary = ""
    current_plan_items = []
    current_composition = nil
    current_theme = ""
    current_preset = ""
    studio_inited = false
    goto(1)
    ui.prompt_input.set_text("")
    ui.source_input.set_text("")
    ui.reference_input.set_text("")
}

fn open_work_idx(i){
    status_text = "idx: " + i.to_string() + " / " + works.len().to_string()
    ui.status.set_text(status_text)
    if i < works.len() {
        if i >= 0 {
            let w = works[i]
            open_work(w["id"])
        }
    }
}

fn delete_work_idx(i){
    if i < works.len() {
        if i >= 0 {
            let w = works[i]
            delete_work(w["id"])
        }
    }
}

fn open_work(id){
    for w in works {
        if w["id"] == id {
            current_id = w["id"]
            current_title = (if w["title"] != nil {w["title"]} else {""})
            current_source = (if w["source"] != nil {w["source"]} else {""})
            current_reference = (if w["reference"] != nil {w["reference"]} else {""})
            current_content = (if w["content"] != nil {w["content"]} else {""})
            current_style = (if w["style"] != nil {w["style"]} else {"改写"})
            current_prompt = (if w["prompt"] != nil {w["prompt"]} else {""})
            plan_kind = (if w["plan_kind"] != nil {w["plan_kind"]} else {""})
            current_plan_title = (if w["plan_title"] != nil {w["plan_title"]} else {""})
            current_plan_summary = (if w["plan_summary"] != nil {w["plan_summary"]} else {""})
            current_plan_items = (if w["plan_items"] != nil {w["plan_items"]} else {[]})
            let legacy_sections = (if w["plan_sections"] != nil {w["plan_sections"]} else {[]})
            let legacy_scenes = (if w["plan_scenes"] != nil {w["plan_scenes"]} else {[]})
            if plan_kind == "image" {
                if current_plan_items.len() == 0 { current_plan_items = legacy_sections }
            }
            if plan_kind == "video" {
                if current_plan_items.len() == 0 { current_plan_items = legacy_scenes }
            }
            current_theme = (if w["theme"] != nil {w["theme"]} else {""})
            current_composition = w.composition
            current_preset = ""
            studio_inited = false
            if plan_kind == "" { goto(2) return }
            goto(3)
            return
        }
    }
}

fn delete_work(id){
    let kept = []
    for w in works {
        if w["id"] != id { kept.push(w) }
    }
    works = kept
    save_works()
    rebuild_known_tags()
    ui.tag_row.render()
    status_text = "已删除 · " + now_label()
    ui.status.set_text(status_text)
    ui.works_list.render()
}

fn upsert_and_save(){
    let stamp = bump_seq()
    let kept = []
    let found = false
    let existing_tags = []
    let existing_history = []
    for w in works {
        if w["id"] == current_id {
            let ex_t = w["tags"]
            if ex_t != nil { existing_tags = ex_t }
            let ex_h = w["history"]
            if ex_h != nil { existing_history = ex_h }
        }
    }
    let legacy_sections = []
    if plan_kind == "image" { legacy_sections = current_plan_items }
    let legacy_scenes = []
    if plan_kind == "video" { legacy_scenes = current_plan_items }
    let entry = {id: current_id title: current_title source: current_source reference: current_reference content: current_content style: current_style prompt: current_prompt plan_kind: plan_kind plan_title: current_plan_title plan_summary: current_plan_summary plan_items: current_plan_items plan_sections: legacy_sections plan_scenes: legacy_scenes theme: current_theme composition: current_composition tags: existing_tags history: existing_history updated: stamp}
    for w in works {
        if w["id"] == current_id {
            kept.push(entry)
            found = true
        } else { kept.push(w) }
    }
    if !found { kept.push(entry) }
    works = kept
    save_works()
    rebuild_known_tags()
    ui.tag_row.render()
    status_text = "已保存 · " + now_label()
    ui.status.set_text(status_text)
    ui.works_list.render()
}

// ---------- 原文二创(octos) ----------

fn style_prompt(){
    if current_style == "翻译" { return "把以下内容翻译成中文,保留术语与原文格式:\n\n" }
    if current_style == "总结" { return "总结以下内容的要点,使用列表形式,每条不超过一行:\n\n" }
    if current_style == "评论" { return "就以下内容写一段评论,300 字以内:\n\n" }
    if current_style == "润色" { return "润色以下文字,让它更自然、更有'人味',去掉机械的 AI 腔调,保留原意:\n\n" }
    if current_style == "续写" { return "顺着以下文字的语气和思路,续写一段长度相近的内容:\n\n" }
    if current_style == "扩写" { return "把以下内容扩写成更充实的版本,补充细节与例子,保持原意:\n\n" }
    if current_style == "小红书体" { return "把以下内容改写成小红书笔记风格:短句分行、适度 emoji、口语化真诚分享:\n\n" }
    return "改写以下内容,保留原意与核心信息,但换一种表达方式:\n\n"
}

fn ask_ai(){
    if busy { return }
    if current_source == "" {
        status_text = "原文为空,无法创作"
        ui.status.set_text(status_text)
        return
    }
    if !octos_available {
        status_text = "octos 助手不可用(降级:可手动创作)"
        ui.status.set_text(status_text)
        return
    }
    busy = true
    status_text = "等待助手…"
    ui.status.set_text(status_text)
    let prompt = style_prompt() + current_source
    host.request("octos.session.open", {}, fn(s){
        if !s.is_ok {
            status_text = "助手不可用: " + s.error
            busy = false
            ui.status.set_text(status_text)
            return
        }
        host.request("octos.turn.start", {text: prompt}, fn(r){
            if r.is_ok && r.data != nil {
                current_content = r.data["text"]
                ui.content_input.set_text(current_content)
                ui.content_input.render()
                add_history_entry(current_style, current_content)
                add_tag_to_current(current_style)
                status_text = "已创作 · " + now_label()
            } else {
                status_text = "助手不可用: " + r.error
            }
            busy = false
            ui.status.set_text(status_text)
        })
    })
}

// ---------- 场景生成(model.complete) ----------

fn scenario_task(){
    let th = theme_prompt()
    if plan_kind == "image" { return "把用户的一句话意图扩展成 3-6 段图文文章大纲,每段配一个英文生图 prompt。" + th }
    if plan_kind == "video" {
        let pl = preset_line()
        if pl == "" { return "把用户的一句话意图扩展成 4-6 镜视频分镜脚本,每镜含镜号/时长/景别/画面描述/配音文案/英文生视频 prompt。" }
        return "把用户的一句话意图扩展成 4-6 镜视频分镜脚本,每镜含镜号/时长/景别/画面描述/配音文案/英文生视频 prompt。整体视觉风格:" + pl
    }
    if plan_kind == "ppt" { return "把用户的一句话意图扩展成 5-8 页演示文稿大纲:封面/目录/内容页/结尾,每页含 2-5 条要点(每条一行)、演讲备注、英文配图 prompt。" + th }
    if plan_kind == "teardown" { return "拆解用户提供的视频文字稿或描述:提炼主线一句话、开头钩子手法、分段结构、镜头语言、金句、可复用的脚本骨架与改进要点。" }
    if plan_kind == "titles" { return "为用户的主题或原文生成 8 个中文候选标题,覆盖不同风格(悬念/数字/对比/情感/干货等),每条附风格标签与 1-100 推荐指数。" }
    if plan_kind == "xhs" { return "把用户的一句话意图写成一篇小红书笔记:标题带表情符号、正文口语化短句并适度使用 emoji、结尾给标签,另配 3 个英文配图 prompt。" + th }
    if plan_kind == "script" { return "把用户的一句话意图写成 30-60 秒真人出镜口播稿:前 3 秒钩子、3-6 个节拍(每拍一句口语化台词)、结尾 CTA,注明总时长与语气。" + th }
    if plan_kind == "mindmap" { return "把用户的主题或原文整理成思维导图大纲:1 个中心主题、3-6 个一级分支、每支 2-5 个子节点,节点均为短语。" }
    if plan_kind == "quotes" { return "围绕用户主题写 8 条中文金句,每条注明适用场景(开场/结尾/转折/点题等)。" }
    return "把用户的一句话意图扩展成结构化内容。"
}

fn scenario_input(){
    if plan_kind == "teardown" { return {transcript: current_source} }
    if plan_kind == "titles" {
        if current_prompt != "" { return {intent: current_prompt source: current_source} }
        return {source: current_source}
    }
    if plan_kind == "mindmap" {
        if current_prompt != "" { return {intent: current_prompt source: current_source} }
        return {source: current_source}
    }
    if plan_kind == "video" { return {intent: current_prompt preset: preset_line()} }
    return {intent: current_prompt}
}

fn scenario_schema(){
    if plan_kind == "image" {
        return {type: "object" required: ["title" "summary" "sections"] additionalProperties: false
            properties: {
                title: {type: "string" maxLength: 40}
                summary: {type: "string" maxLength: 200}
                sections: {type: "array" minItems: 3 maxItems: 6
                    items: {type: "object" required: ["heading" "body" "image_prompt"] additionalProperties: false
                        properties: {
                            heading: {type: "string" maxLength: 30}
                            body: {type: "string" maxLength: 400}
                            image_prompt: {type: "string" maxLength: 300}
                        }}}
            }}
    }
    if plan_kind == "video" {
        return {type: "object" required: ["title" "logline" "scenes"] additionalProperties: false
            properties: {
                title: {type: "string" maxLength: 40}
                logline: {type: "string" maxLength: 200}
                scenes: {type: "array" minItems: 3 maxItems: 6
                    items: {type: "object" required: ["id" "duration_s" "shot_type" "description" "voiceover" "video_prompt"] additionalProperties: false
                        properties: {
                            id: {type: "string" maxLength: 10}
                            duration_s: {type: "integer" minimum: 1 maximum: 60}
                            shot_type: {type: "string" maxLength: 20}
                            description: {type: "string" maxLength: 200}
                            voiceover: {type: "string" maxLength: 300}
                            video_prompt: {type: "string" maxLength: 300}
                        }}}
            }}
    }
    if plan_kind == "ppt" {
        return {type: "object" required: ["deck_title" "subtitle" "slides"] additionalProperties: false
            properties: {
                deck_title: {type: "string" maxLength: 40}
                subtitle: {type: "string" maxLength: 80}
                slides: {type: "array" minItems: 5 maxItems: 10
                    items: {type: "object" required: ["kind" "title" "bullets" "notes" "visual_prompt"] additionalProperties: false
                        properties: {
                            kind: {type: "string" maxLength: 10}
                            title: {type: "string" maxLength: 40}
                            bullets: {type: "array" minItems: 2 maxItems: 5 items: {type: "string" maxLength: 60}}
                            notes: {type: "string" maxLength: 160}
                            visual_prompt: {type: "string" maxLength: 240}
                        }}}
            }}
    }
    if plan_kind == "teardown" {
        return {type: "object" required: ["video_title" "one_liner" "hook" "structure" "shot_language" "golden_quotes" "reusable" "takeaways"] additionalProperties: false
            properties: {
                video_title: {type: "string" maxLength: 60}
                one_liner: {type: "string" maxLength: 140}
                hook: {type: "object" required: ["pattern" "why"] additionalProperties: false
                    properties: {
                        pattern: {type: "string" maxLength: 40}
                        why: {type: "string" maxLength: 200}
                    }}
                structure: {type: "array" minItems: 3 maxItems: 6
                    items: {type: "object" required: ["time_hint" "purpose" "summary"] additionalProperties: false
                        properties: {
                            time_hint: {type: "string" maxLength: 20}
                            purpose: {type: "string" maxLength: 30}
                            summary: {type: "string" maxLength: 160}
                        }}}
                shot_language: {type: "array" minItems: 2 maxItems: 5
                    items: {type: "object" required: ["name" "effect"] additionalProperties: false
                        properties: {
                            name: {type: "string" maxLength: 20}
                            effect: {type: "string" maxLength: 120}
                        }}}
                golden_quotes: {type: "array" minItems: 1 maxItems: 5 items: {type: "string" maxLength: 80}}
                reusable: {type: "object" required: ["angle" "script_skeleton"] additionalProperties: false
                    properties: {
                        angle: {type: "string" maxLength: 140}
                        script_skeleton: {type: "array" minItems: 3 maxItems: 6 items: {type: "string" maxLength: 90}}
                    }}
                takeaways: {type: "array" minItems: 2 maxItems: 4 items: {type: "string" maxLength: 120}}
            }}
    }
    if plan_kind == "titles" {
        return {type: "object" required: ["titles"] additionalProperties: false
            properties: {
                titles: {type: "array" minItems: 5 maxItems: 8
                    items: {type: "object" required: ["text" "style_tag" "score"] additionalProperties: false
                        properties: {
                            text: {type: "string" maxLength: 40}
                            style_tag: {type: "string" maxLength: 10}
                            score: {type: "integer" minimum: 1 maximum: 100}
                        }}}
            }}
    }
    if plan_kind == "xhs" {
        return {type: "object" required: ["title" "body" "tags" "image_prompts"] additionalProperties: false
            properties: {
                title: {type: "string" maxLength: 24}
                body: {type: "string" maxLength: 800}
                tags: {type: "array" minItems: 3 maxItems: 6 items: {type: "string" maxLength: 12}}
                image_prompts: {type: "array" minItems: 3 maxItems: 3 items: {type: "string" maxLength: 200}}
            }}
    }
    if plan_kind == "script" {
        return {type: "object" required: ["hook" "beats" "cta" "total_s" "tone"] additionalProperties: false
            properties: {
                hook: {type: "string" maxLength: 60}
                beats: {type: "array" minItems: 3 maxItems: 6
                    items: {type: "object" required: ["label" "line"] additionalProperties: false
                        properties: {
                            label: {type: "string" maxLength: 12}
                            line: {type: "string" maxLength: 160}
                        }}}
                cta: {type: "string" maxLength: 60}
                total_s: {type: "integer" minimum: 15 maximum: 180}
                tone: {type: "string" maxLength: 20}
            }}
    }
    if plan_kind == "mindmap" {
        return {type: "object" required: ["root" "branches"] additionalProperties: false
            properties: {
                root: {type: "string" maxLength: 20}
                branches: {type: "array" minItems: 3 maxItems: 6
                    items: {type: "object" required: ["label" "children"] additionalProperties: false
                        properties: {
                            label: {type: "string" maxLength: 20}
                            children: {type: "array" minItems: 2 maxItems: 5 items: {type: "string" maxLength: 20}}
                        }}}
            }}
    }
    if plan_kind == "quotes" {
        return {type: "object" required: ["quotes"] additionalProperties: false
            properties: {
                quotes: {type: "array" minItems: 6 maxItems: 10
                    items: {type: "object" required: ["text" "use_case"] additionalProperties: false
                        properties: {
                            text: {type: "string" maxLength: 60}
                            use_case: {type: "string" maxLength: 20}
                        }}}
            }}
    }
    return {type: "object" required: ["title"] additionalProperties: false properties: {title: {type: "string" maxLength: 40}}}
}

fn absorb_output(out){
    if plan_kind == "image" {
        let title_v = out["title"]
        let summary_v = out["summary"]
        let sections_v = out["sections"]
        current_plan_title = (if title_v != nil {"" + title_v} else {current_prompt})
        current_title = current_plan_title
        current_plan_summary = (if summary_v != nil {"" + summary_v} else {""})
        current_plan_items = (if sections_v != nil {sections_v} else {[]})
        if current_plan_items.len() == 0 { return false }
        return true
    }
    if plan_kind == "video" {
        let title_v = out["title"]
        let logline_v = out["logline"]
        let scenes_v = out["scenes"]
        current_plan_title = (if title_v != nil {"" + title_v} else {current_prompt})
        current_title = current_plan_title
        current_plan_summary = (if logline_v != nil {"" + logline_v} else {""})
        current_plan_items = (if scenes_v != nil {scenes_v} else {[]})
        if current_plan_items.len() == 0 { return false }
        return true
    }
    if plan_kind == "ppt" {
        let title_v = out["deck_title"]
        let sub_v = out["subtitle"]
        let slides_v = out["slides"]
        current_plan_title = (if title_v != nil {"" + title_v} else {current_prompt})
        current_title = current_plan_title
        current_plan_summary = (if sub_v != nil {"" + sub_v} else {""})
        let items = []
        if slides_v != nil {
            for sl in slides_v {
                let bt = ""
                let bl = sl["bullets"]
                if bl != nil {
                    for b in bl {
                        if bt == "" { bt = "" + b } else { bt = bt + ";" + b }
                    }
                }
                items.push({kind: sval(sl["kind"]) title: sval(sl["title"]) bullets_text: bt notes: sval(sl["notes"]) visual_prompt: sval(sl["visual_prompt"])})
            }
        }
        current_plan_items = items
        if items.len() == 0 { return false }
        return true
    }
    if plan_kind == "teardown" {
        let items = []
        let oneliner = sval(out["one_liner"])
        if oneliner != "" { items.push({label: "一句话" text: oneliner}) }
        let hook = out["hook"]
        if hook != nil {
            items.push({label: "钩子 · " + sval(hook["pattern"]) text: sval(hook["why"])})
        }
        let st = out["structure"]
        if st != nil {
            for s in st {
                items.push({label: "结构 · " + sval(s["time_hint"]) + " " + sval(s["purpose"]) text: sval(s["summary"])})
            }
        }
        let sl = out["shot_language"]
        if sl != nil {
            for s in sl {
                items.push({label: "镜头 · " + sval(s["name"]) text: sval(s["effect"])})
            }
        }
        let gq = out["golden_quotes"]
        if gq != nil {
            for q in gq {
                items.push({label: "金句" text: sval(q)})
            }
        }
        let ru = out["reusable"]
        if ru != nil {
            items.push({label: "复用角度" text: sval(ru["angle"])})
            let sk = ru["script_skeleton"]
            if sk != nil {
                for k in sk {
                    items.push({label: "复用骨架" text: sval(k)})
                }
            }
        }
        let tk = out["takeaways"]
        if tk != nil {
            for t in tk {
                items.push({label: "要点" text: sval(t)})
            }
        }
        current_plan_title = sval(out["video_title"])
        if current_plan_title == "" { current_plan_title = "拆解报告" }
        current_title = current_plan_title
        current_plan_items = items
        if items.len() == 0 { return false }
        return true
    }
    if plan_kind == "titles" {
        let items = []
        let tv = out["titles"]
        if tv != nil {
            for t in tv {
                items.push({text: sval(t["text"]) style_tag: sval(t["style_tag"]) score: sval(t["score"])})
            }
        }
        current_plan_title = "标题候选"
        current_title = "标题候选 · " + current_prompt
        current_plan_items = items
        if items.len() == 0 { return false }
        return true
    }
    if plan_kind == "xhs" {
        let title_v = out["title"]
        let body_v = out["body"]
        let tags_v = out["tags"]
        let prompts_v = out["image_prompts"]
        current_plan_title = (if title_v != nil {"" + title_v} else {current_prompt})
        current_title = current_plan_title
        current_content = (if body_v != nil {"" + body_v} else {""})
        let tagline = ""
        if tags_v != nil {
            for tg in tags_v {
                tagline = tagline + "#" + sval(tg) + " "
            }
        }
        current_plan_summary = tagline
        let items = []
        let n = 0
        if prompts_v != nil {
            for p in prompts_v {
                n += 1
                items.push({heading: "配图 " + n.to_string() body: sval(p)})
            }
        }
        current_plan_items = items
        if current_content == "" { return false }
        return true
    }
    if plan_kind == "script" {
        let items = []
        let hook_v = out["hook"]
        if hook_v != nil { items.push({label: "钩子 · 前3秒" text: "" + hook_v}) }
        let beats_v = out["beats"]
        if beats_v != nil {
            for b in beats_v {
                items.push({label: "节拍 · " + sval(b["label"]) text: sval(b["line"])})
            }
        }
        let cta_v = out["cta"]
        if cta_v != nil { items.push({label: "CTA" text: "" + cta_v}) }
        current_plan_title = (if current_prompt != "" {current_prompt} else {"口播稿"})
        current_title = "口播稿 · " + current_plan_title
        current_plan_summary = sval(out["tone"]) + " · 约 " + sval(out["total_s"]) + " 秒"
        current_plan_items = items
        if items.len() == 0 { return false }
        return true
    }
    if plan_kind == "mindmap" {
        let root_v = out["root"]
        let br_v = out["branches"]
        current_plan_title = (if root_v != nil {"" + root_v} else {current_prompt})
        current_title = "导图 · " + current_plan_title
        let items = []
        if br_v != nil {
            for br in br_v {
                let ct = ""
                let ch = br["children"]
                if ch != nil {
                    for c in ch {
                        if ct == "" { ct = "" + c } else { ct = ct + ";" + c }
                    }
                }
                items.push({label: sval(br["label"]) text: ct})
            }
        }
        current_plan_items = items
        if items.len() == 0 { return false }
        return true
    }
    if plan_kind == "quotes" {
        let items = []
        let qv = out["quotes"]
        if qv != nil {
            for q in qv {
                items.push({label: sval(q["use_case"]) text: sval(q["text"])})
            }
        }
        current_plan_title = "金句 · " + current_prompt
        current_title = current_plan_title
        current_plan_items = items
        if items.len() == 0 { return false }
        return true
    }
    return false
}

fn load_demo_plan(){
    if plan_kind == "image" {
        current_plan_title = (if current_prompt != "" {current_prompt} else {"海边慢生活"})
        current_title = current_plan_title
        current_plan_summary = "关于夏日海边慢生活的散文式记录,从清晨到星夜。"
        current_plan_items = demo_article_sections()
        current_source = "【意图】" + current_prompt + "\n\n【demo 数据,可手动修改】"
        return
    }
    if plan_kind == "video" {
        current_plan_title = (if current_prompt != "" {current_prompt} else {"海边慢生活"})
        current_title = current_plan_title
        current_plan_summary = "夏日海边慢生活,一天四个时段的治愈片段。"
        current_plan_items = demo_video_scenes()
        current_source = "【意图】" + current_prompt + "\n\n【demo 数据,可手动修改】"
        return
    }
    if plan_kind == "ppt" {
        current_plan_title = (if current_prompt != "" {current_prompt} else {"夏日海边慢生活"})
        current_title = "PPT · " + current_plan_title
        current_plan_summary = "一场关于节奏的分享"
        current_plan_items = demo_ppt_slides()
        return
    }
    if plan_kind == "teardown" {
        current_plan_title = "拆解 · 治愈系慢生活视频"
        current_title = current_plan_title
        current_plan_items = demo_teardown_items()
        return
    }
    if plan_kind == "titles" {
        current_plan_title = "标题候选"
        current_title = "标题候选 · " + (if current_prompt != "" {current_prompt} else {"海边慢生活"})
        current_plan_items = demo_titles_items()
        return
    }
    if plan_kind == "xhs" {
        current_plan_title = "🏝️ 海边慢生活|把假期过成诗的 4 个瞬间"
        current_title = "小红书 · 海边慢生活"
        current_content = "谁说假期一定要排满🌅 清晨六点的海滩只属于浪和风,光脚踩上去,细沙还带着夜的凉意。白天就窝在椰影下的吊床里,一杯冰椰🧊,时间慢得能听见冰块融化。黄昏别走,等一场完整的日落🍊,天空从金黄烧到紫,再慢慢暗成深蓝。夜里躺在沙滩上数星星✨,银河就铺在头顶。慢生活不是懒,是把时间花在感觉上。"
        current_plan_summary = "#海边度假 #慢生活 #治愈系 #夏日旅行 #出片攻略 "
        current_plan_items = demo_xhs_items()
        return
    }
    if plan_kind == "script" {
        current_plan_title = (if current_prompt != "" {current_prompt} else {"海边慢生活"})
        current_title = "口播稿 · " + current_plan_title
        current_plan_summary = "治愈系口吻 · 约 45 秒"
        current_plan_items = demo_script_items()
        return
    }
    if plan_kind == "mindmap" {
        current_plan_title = (if current_prompt != "" {current_prompt} else {"海边慢生活"})
        current_title = "导图 · " + current_plan_title
        current_plan_items = demo_mindmap_items()
        return
    }
    if plan_kind == "quotes" {
        current_plan_title = "金句 · " + (if current_prompt != "" {current_prompt} else {"海边慢生活"})
        current_title = current_plan_title
        current_plan_items = demo_quotes_items()
        return
    }
}

fn ask_scenario(){
    if busy { return }
    if plan_kind == "teardown" {
        if current_source == "" {
            status_text = "请先粘贴视频文字稿或描述"
            ui.status.set_text(status_text)
            return
        }
    } else {
        if plan_kind == "titles" {
            if current_prompt == "" {
                if current_source == "" {
                    status_text = "意图与原文都为空"
                    ui.status.set_text(status_text)
                    return
                }
            }
        } else {
            if current_prompt == "" {
                status_text = "意图为空"
                ui.status.set_text(status_text)
                return
            }
        }
    }
    if !model_available {
        load_demo_plan()
        status_text = "model 不可用,已填入演示内容(可手动编辑)"
        ui.status.set_text(status_text)
        studio_inited = false
        goto(3)
        return
    }
    busy = true
    arm_watchdog()
    status_text = gen_status(plan_kind)
    ui.status.set_text(status_text)
    ui.generate_btn.set_text("生成中…")
    host.request("model.complete", {
        task: scenario_task()
        input: scenario_input()
        schema: scenario_schema()
        class: "strong"
        allow_urls: false
    }, fn(r){
        disarm_watchdog()
        let good = false
        if r.is_ok {
            if r.data != nil {
                let out = r.data["output"]
                if out != nil { good = absorb_output(out) }
            }
        }
        if good { } else { load_demo_plan() }
        if good {
            status_text = kind_done_note(plan_kind)
            let summary = sval(current_plan_title)
            if summary == "" { summary = kind_name(plan_kind) }
            summary = summary + " · " + current_plan_items.len().to_string() + " 条"
            add_history_entry(current_prompt, summary)
            add_tag_to_current(kind_name(plan_kind))
        } else {
            status_text = "model 不可用(" + (if r.error != nil {r.error} else {"无返回"}) + "),已填入演示内容"
        }
        busy = false
        ui.status.set_text(status_text)
        ui.generate_btn.set_text(gen_label(plan_kind))
        studio_inited = false
        goto(3)
    })
}

fn ask_composition(){
    if busy { return }
    if plan_kind != "video" { return }
    if current_plan_items.len() == 0 {
        status_text = "先有分镜,再生成合成建议"
        ui.status.set_text(status_text)
        return
    }
    if !model_available {
        current_composition = demo_composition()
        status_text = "model 不可用,填入演示合成建议"
        ui.status.set_text(status_text)
        refresh_comp()
        return
    }
    busy = true
    arm_watchdog()
    status_text = "生成合成建议…"
    ui.status.set_text(status_text)
    host.request("model.complete", {
        task: "为以下视频分镜生成后期合成建议:转场风格、背景音乐情绪、节奏、调色、字幕样式、输出参数。"
        input: {title: current_plan_title total_s: total_duration() scenes: current_plan_items}
        schema: {type: "object" required: ["transition_style" "bgm_mood" "pacing_note" "color_grade" "subtitle_style" "output_hint"] additionalProperties: false
            properties: {
                transition_style: {type: "string" maxLength: 60}
                bgm_mood: {type: "string" maxLength: 80}
                pacing_note: {type: "string" maxLength: 140}
                color_grade: {type: "string" maxLength: 80}
                subtitle_style: {type: "string" maxLength: 60}
                output_hint: {type: "string" maxLength: 60}
            }}
        class: "strong"
        allow_urls: false
    }, fn(r){
        disarm_watchdog()
        let done = false
        if r.is_ok {
            if r.data != nil {
                let out = r.data["output"]
                if out != nil {
                    current_composition = out
                    done = true
                    status_text = "合成建议已就绪 · " + now_label()
                }
            }
        }
        if done { } else {
            current_composition = demo_composition()
            status_text = "model 不可用,填入演示合成建议"
        }
        busy = false
        ui.status.set_text(status_text)
        refresh_comp()
    })
}

// ---------- 条目操作 ----------

fn item_move_up(it){
    item_move_item(it, -1)
}

fn item_move_down(it){
    item_move_item(it, 1)
}

fn item_move_item(it, dir){
    cancel_edit()
    let i = idx_of_item(it)
    if i < 0 { return }
    let n = current_plan_items.len()
    let j = i + dir
    if j < 0 { return }
    if j >= n { return }
    let fresh = []
    for k in n {
        if k == i {
            fresh.push(current_plan_items[j])
        } else {
            if k == j {
                fresh.push(current_plan_items[i])
            } else {
                fresh.push(current_plan_items[k])
            }
        }
    }
    current_plan_items = fresh
    ui.plan_inner.render()
}

fn item_delete_item(it){
    cancel_edit()
    let i = idx_of_item(it)
    if i < 0 { return }
    current_plan_items.remove(i)
    status_text = "已删除 1 条 · " + now_label()
    ui.status.set_text(status_text)
    ui.plan_inner.render()
    ui.plan_word.set_text(plan_word())
}

fn item_add(){
    current_plan_items.push(blank_item(plan_kind))
    ui.plan_inner.render()
    ui.plan_word.set_text(plan_word())
}

fn ensure_item_keys(){
    for it in current_plan_items {
        if it["_k"] == nil { it["_k"] = bump_seq() }
    }
}

fn idx_of_item(it){
    let k = it["_k"]
    if k == nil { return -1 }
    for j in current_plan_items.len() {
        if current_plan_items[j]["_k"] == k { return j }
    }
    return -1
}

fn start_edit_item(it){
    let j = idx_of_item(it)
    if j < 0 { return }
    editing_k = it["_k"]
    ui.plan_inner.render()
}

fn apply_edit(){
    if editing_k < 0 { return }
    let j = -1
    for q in current_plan_items.len() {
        if current_plan_items[q]["_k"] == editing_k { j = q }
    }
    if j < 0 { editing_k = -1; return }
    let it = current_plan_items[j]
    let fields = item_fields(plan_kind)
    let n = fields.len()
    if n > 0 {
        let v = ui.edit1_input.text()
        if v != "" { it[fields[0]["key"]] = v }
    }
    if n > 1 {
        let v = ui.edit2_input.text()
        if v != "" { it[fields[1]["key"]] = v }
    }
    if n > 2 {
        let v = ui.edit3_input.text()
        if v != "" { it[fields[2]["key"]] = v }
    }
    if n > 3 {
        let v = ui.edit4_input.text()
        if v != "" { it[fields[3]["key"]] = v }
    }
    if n > 4 {
        let v = ui.edit5_input.text()
        if v != "" { it[fields[4]["key"]] = v }
    }
    if n > 5 {
        let v = ui.edit6_input.text()
        if v != "" { it[fields[5]["key"]] = v }
    }
    current_plan_items[j] = it
    editing_k = -1
    ui.plan_inner.render()
    status_text = "已写入 · " + now_label()
    ui.status.set_text(status_text)
}

fn cancel_edit(){
    editing_k = -1
    ui.plan_inner.render()
}

fn toggle_images(){
    images_on = !images_on
    ui.images_btn.set_text((if images_on {"配图:开"} else {"配图:关"}))
    ui.plan_inner.render()
    if mode == 2 {
        if current_reference != "" {
            if images_on {
                ui.reference_image.set_visible(true)
                ui.reference_image.set_src(http_resource(current_reference))
            } else {
                ui.reference_image.set_visible(false)
                ui.reference_image.set_src(nil)
            }
        }
    }
}

fn teardown_to_template(){
    let lines = ""
    for it in current_plan_items {
        let lb = sval(it["label"])
        if lb == "复用骨架" {
            let tx = sval(it["text"])
            if tx != "" {
                if lines == "" { lines = tx } else { lines = lines + "\n" + tx }
            }
        }
    }
    if lines == "" {
        status_text = "没有可复用的骨架条目"
        ui.status.set_text(status_text)
        return
    }
    start_scenario("video")
    current_prompt = lines
    ui.prompt_input.set_text(lines)
    status_text = "骨架已注入视频意图,可直接生成分镜"
    ui.status.set_text(status_text)
}

fn switch_scenario(id){
    plan_kind = id
    refresh_compose()
}

// ---------- 渲染器 ----------

fn rt_image(fmt){
    let md = "# " + current_plan_title + "\n\n"
    if current_plan_summary != "" { md = md + "> " + current_plan_summary + "\n\n" }
    for s in current_plan_items {
        md = md + "## " + sval(s["heading"]) + "\n\n" + sval(s["body"]) + "\n\n> 生图 prompt: " + sval(s["image_prompt"]) + "\n\n"
    }
    if fmt == "markdown" { return md }
    if fmt == "wechat" {
        let mp = current_plan_title + "\n\n"
        for s in current_plan_items {
            mp = mp + sval(s["heading"]) + "\n\n" + sval(s["body"]) + "\n\n[图片: prompt=" + sval(s["image_prompt"]) + "]\n\n"
        }
        return mp
    }
    let nt = "# " + current_plan_title + "\n\n"
    for s in current_plan_items {
        nt = nt + "## " + sval(s["heading"]) + "\n\n" + sval(s["body"]) + "\n\n> 🖼 生图 prompt: `" + sval(s["image_prompt"]) + "`\n\n"
    }
    return nt
}

fn rt_video(fmt){
    let md = "# " + current_plan_title + "\n\n"
    if current_plan_summary != "" { md = md + "> " + current_plan_summary + "\n\n" }
    for s in current_plan_items {
        let ds = dur_int(s["duration_s"]).to_string()
        md = md + "## Scene " + sval(s["id"]) + " (" + ds + "s · " + sval(s["shot_type"]) + ")\n\n"
        md = md + "- 描述: " + sval(s["description"]) + "\n"
        md = md + "- 配音: " + sval(s["voiceover"]) + "\n"
        md = md + "> 生视频 prompt: " + sval(s["video_prompt"]) + "\n\n"
    }
    if fmt == "markdown" { return md }
    if fmt == "wechat" {
        let mp = current_plan_title + "\n\n"
        for s in current_plan_items {
            let ds = dur_int(s["duration_s"]).to_string()
            mp = mp + "【" + sval(s["id"]) + " · " + ds + "秒 · " + sval(s["shot_type"]) + "】\n\n"
            mp = mp + sval(s["description"]) + "\n\n🎙️ " + sval(s["voiceover"]) + "\n\n"
        }
        return mp
    }
    let nt = "# " + current_plan_title + "\n\n| # | 时长 | 景别 | 描述 | 配音 |\n|---|---|---|---|---|\n"
    for s in current_plan_items {
        let ds = dur_int(s["duration_s"]).to_string()
        nt = nt + "| " + sval(s["id"]) + " | " + ds + "s | " + sval(s["shot_type"]) + " | " + sval(s["description"]) + " | " + sval(s["voiceover"]) + " |\n"
    }
    return nt
}

fn rt_ppt(fmt){
    if fmt == "wechat" {
        let mp = current_plan_title + "\n\n"
        for it in current_plan_items {
            mp = mp + "【" + sval(it["kind"]) + "】" + sval(it["title"]) + "\n"
            let parts = sval(it["bullets_text"]).split(";")
            for p in parts {
                if p != "" { mp = mp + "· " + p + "\n" }
            }
            mp = mp + "\n"
        }
        return mp
    }
    let out = "# " + current_plan_title + "\n\n"
    if current_plan_summary != "" { out = out + "> " + current_plan_summary + "\n\n" }
    for it in current_plan_items {
        out = out + "## [" + sval(it["kind"]) + "] " + sval(it["title"]) + "\n\n"
        let parts = sval(it["bullets_text"]).split(";")
        for p in parts {
            if p != "" { out = out + "- " + p + "\n" }
        }
        let nt = sval(it["notes"])
        if nt != "" { out = out + "\n> 讲稿: " + nt + "\n" }
        out = out + "\n"
    }
    return out
}

fn rt_rows(fmt){
    if fmt == "markdown" {
        let out = "# " + current_plan_title + "\n\n"
        if current_plan_summary != "" { out = out + "> " + current_plan_summary + "\n\n" }
        for it in current_plan_items {
            out = out + "## " + sval(it["label"]) + "\n\n" + sval(it["text"]) + "\n\n"
        }
        return out
    }
    if fmt == "wechat" {
        let out = current_plan_title + "\n\n"
        for it in current_plan_items {
            out = out + "【" + sval(it["label"]) + "】\n" + sval(it["text"]) + "\n\n"
        }
        return out
    }
    let out = "# " + current_plan_title + "\n\n"
    for it in current_plan_items {
        out = out + "- **" + sval(it["label"]) + "** — " + sval(it["text"]) + "\n"
    }
    return out
}

fn rt_titles(fmt){
    if fmt == "wechat" {
        let out = "标题候选 · " + current_prompt + "\n\n"
        let n = 0
        for it in current_plan_items {
            n += 1
            out = out + n.to_string() + ". " + sval(it["text"]) + "(" + sval(it["style_tag"]) + " " + sval(it["score"]) + "分)\n"
        }
        return out
    }
    let out = "# 标题候选\n\n"
    let n = 0
    for it in current_plan_items {
        n += 1
        out = out + "" + n.to_string() + ". **" + sval(it["text"]) + "** · " + sval(it["style_tag"]) + " · 推荐 " + sval(it["score"]) + "\n"
    }
    return out
}

fn rt_xhs(fmt){
    if fmt == "wechat" {
        let out = current_plan_title + "\n\n" + current_content + "\n\n" + current_plan_summary + "\n"
        return out
    }
    let out = "# " + current_plan_title + "\n\n"
    if current_plan_summary != "" { out = out + "> 标签: " + current_plan_summary + "\n\n" }
    out = out + current_content + "\n\n**配图 prompt:**\n\n"
    for it in current_plan_items {
        out = out + "- " + sval(it["heading"]) + ": " + sval(it["body"]) + "\n"
    }
    return out
}

fn srt_text(){
    let out = ""
    let t = 0
    let idx = 1
    for it in current_plan_items {
        let d = dur_int(it["duration_s"])
        let vo = sval(it["voiceover"])
        if vo == "" { vo = sval(it["description"]) }
        out = out + idx.to_string() + "\n" + srt_time(t) + " --> " + srt_time(t + d) + "\n" + vo + "\n\n"
        t = t + d
        idx = idx + 1
    }
    return out
}

fn total_duration(){
    let t = 0
    for it in current_plan_items {
        t = t + dur_int(it["duration_s"])
    }
    return t
}

fn pack_text(){
    let out = "# 视频制作包 · " + current_plan_title + "\n\n"
    out = out + "总时长约 " + total_duration().to_string() + " 秒 · " + current_plan_items.len().to_string() + " 镜\n\n"
    out = out + "## 一、素材清单(逐镜生成)\n\n"
    for it in current_plan_items {
        let ds = dur_int(it["duration_s"]).to_string()
        out = out + "- " + sval(it["id"]) + " · " + ds + "s · " + sval(it["shot_type"]) + "\n"
        out = out + "  prompt: " + sval(it["video_prompt"]) + "\n"
        out = out + "  画面: " + sval(it["description"]) + "\n"
    }
    out = out + "\n## 二、字幕(保存为 subtitle.srt)\n\n" + srt_text()
    out = out + "\n## 三、合成建议\n\n"
    if current_composition != nil {
        out = out + "- 转场: " + sval(current_composition["transition_style"]) + "\n"
        out = out + "- 配乐: " + sval(current_composition["bgm_mood"]) + "\n"
        out = out + "- 节奏: " + sval(current_composition["pacing_note"]) + "\n"
        out = out + "- 调色: " + sval(current_composition["color_grade"]) + "\n"
        out = out + "- 字幕: " + sval(current_composition["subtitle_style"]) + "\n"
        out = out + "- 输出: " + sval(current_composition["output_hint"]) + "\n"
    } else {
        out = out + "(未生成 — 回到计划页点「AI 合成建议」)\n"
    }
    out = out + "\n## 四、ffmpeg 参考\n\n"
    out = out + "1. 逐镜生成素材,命名为 S1.mp4 S2.mp4 …(时长按清单)\n"
    out = out + "2. concat.txt 内容:\n"
    for it in current_plan_items {
        out = out + "file '" + sval(it["id"]) + ".mp4'\n"
    }
    out = out + "\n3. 拼接: ffmpeg -f concat -safe 0 -i concat.txt -c copy body.mp4\n"
    out = out + "4. 烧字幕: ffmpeg -i body.mp4 -vf subtitles=subtitle.srt out.mp4\n"
    return out
}

fn marp_text(){
    let out = "---\nmarp: true\ntheme: default\npaginate: true\n---\n\n"
    out = out + "# " + current_plan_title + "\n"
    if current_plan_summary != "" { out = out + current_plan_summary + "\n" }
    out = out + "\n"
    for it in current_plan_items {
        out = out + "---\n\n"
        let kd = sval(it["kind"])
        if kd == "cover" {
            out = out + "# " + sval(it["title"]) + "\n\n"
        } else {
            if kd == "end" {
                out = out + "# " + sval(it["title"]) + "\n\n"
            } else {
                out = out + "## " + sval(it["title"]) + "\n\n"
            }
        }
        let parts = sval(it["bullets_text"]).split(";")
        for p in parts {
            if p != "" { out = out + "- " + p + "\n" }
        }
        out = out + "\n"
        let nt = sval(it["notes"])
        if nt != "" { out = out + "<!-- " + nt + " -->\n" }
    }
    return out
}

fn markmap_text(){
    let out = "# " + current_plan_title + "\n"
    for it in current_plan_items {
        out = out + "- " + sval(it["label"]) + "\n"
        let parts = sval(it["text"]).split(";")
        for p in parts {
            if p != "" { out = out + "  - " + p + "\n" }
        }
    }
    return out
}

fn render_plan_as_text(){
    if plan_format == "srt" {
        if plan_kind == "video" { return srt_text() }
    }
    if plan_format == "pack" {
        if plan_kind == "video" { return pack_text() }
    }
    if plan_format == "marp" {
        if plan_kind == "ppt" { return marp_text() }
    }
    if plan_format == "markmap" {
        if plan_kind == "mindmap" { return markmap_text() }
    }
    if plan_kind == "image" { return rt_image(plan_format) }
    if plan_kind == "video" { return rt_video(plan_format) }
    if plan_kind == "ppt" { return rt_ppt(plan_format) }
    if plan_kind == "titles" { return rt_titles(plan_format) }
    if plan_kind == "xhs" { return rt_xhs(plan_format) }
    if plan_kind == "teardown" { return rt_rows(plan_format) }
    if plan_kind == "script" { return rt_rows(plan_format) }
    if plan_kind == "mindmap" { return rt_rows(plan_format) }
    if plan_kind == "quotes" { return rt_rows(plan_format) }
    return current_content
}

// ---------- 导航 ----------

fn refresh_compose(){
    let cfg = scenario_cfg(plan_kind)
    ui.scenario_row1.render()
    ui.scenario_row2.render()
    ui.theme_row.set_visible(cfg["theme"])
    ui.theme_row1.render()
    ui.theme_row2.render()
    ui.preset_row.set_visible(plan_kind == "video")
    ui.preset_chips.render()
    ui.reference_label.set_visible(plan_kind == "")
    ui.reference_input.set_visible(plan_kind == "")
    ui.prompt_label.set_visible(cfg["intent"])
    ui.prompt_input.set_visible(cfg["intent"])
    ui.source_label.set_visible(cfg["source"])
    ui.source_input.set_visible(cfg["source"])
    ui.compose_hint.set_text(compose_hint(plan_kind))
    ui.model_label.set_text("模型: " + (if model_available {"model.complete 可用"} else {"未授予(降级为演示内容)"}))
    ui.compose_btn.set_visible(plan_kind == "")
    ui.generate_btn.set_visible(plan_kind != "")
    ui.generate_btn.set_text((if busy {"生成中…"} else {gen_label(plan_kind)}))
}

fn comp_lines(){
    let c = current_composition
    return "转场 " + sval(c["transition_style"]) + "\n配乐 " + sval(c["bgm_mood"]) + "\n节奏 " + sval(c["pacing_note"]) + "\n调色 " + sval(c["color_grade"]) + "\n字幕 " + sval(c["subtitle_style"]) + "\n输出 " + sval(c["output_hint"])
}

fn refresh_comp(){
    if plan_kind != "video" { return }
    if current_composition == nil {
        ui.comp_head.set_text("合成建议(未生成)")
        ui.comp_body.set_text("点下方「AI 合成建议」生成转场/配乐/节奏/调色/字幕/输出参数。")
        return
    }
    ui.comp_head.set_text("合成建议")
    ui.comp_body.set_text(comp_lines())
}

fn plan_word(){
    return "共 " + current_plan_items.len().to_string() + " 条 · 摘要 " + word_count(current_plan_summary).to_string() + " 字"
}

fn refresh_plan(){
    editing_k = -1
    ensure_item_keys()
    ui.plan_kind_label.set_text(kind_emoji(plan_kind) + " " + kind_name(plan_kind))
    ui.plan_hint.set_text(plan_hint(plan_kind))
    let t = current_plan_title
    if t == "" { t = current_title }
    ui.plan_title_input.set_text(t)
    ui.plan_content_label.set_visible(plan_kind == "xhs")
    ui.plan_content_input.set_visible(plan_kind == "xhs")
    if plan_kind == "xhs" { ui.plan_content_input.set_text(current_content) }
    ui.comp_card.set_visible(plan_kind == "video")
    ui.comp_btn.set_visible(plan_kind == "video")
    ui.tpl_btn.set_visible(plan_kind == "teardown")
    refresh_comp()
    ui.plan_inner.render()
    ui.plan_word.set_text(plan_word())
}

fn refresh_export(){
    let fs = kind_formats(plan_kind)
    let first = "markdown"
    if fs.len() > 0 { first = fs[0]["id"] }
    plan_format = first
    ui.export_title.set_text(current_title)
    ui.export_body.set_text(render_plan_as_text())
    ui.export_hint.set_text(format_hint(plan_format))
    ui.export_formats.render()
}

fn goto(m){
    mode = m
    ui.home_view.set_visible(mode == 0)
    ui.compose_view.set_visible(mode == 1)
    ui.studio_view.set_visible(mode == 2)
    ui.plan_view.set_visible(mode == 3)
    ui.export_view.set_visible(mode == 4)
    ui.tabs.render()
    ui.works_list.render()
    if m == 1 { refresh_compose() }
    if m == 2 {
        ui.source_preview.set_text(current_source)
        if !studio_inited {
            if current_title != "" { ui.title_input.set_text(current_title) }
            if current_content != "" { ui.content_input.set_text(current_content) }
            studio_inited = true
        }
        if current_reference != "" {
            ui.reference_label.set_visible(true)
            ui.reference_caption.set_visible(true)
            ui.reference_caption.set_text("已记 URL(预览需联网): " + current_reference)
            if images_on {
                ui.reference_image.set_visible(true)
                ui.reference_image.set_src(http_resource(current_reference))
            } else {
                ui.reference_image.set_visible(false)
            }
        }
        if current_reference == "" {
            ui.reference_label.set_visible(false)
            ui.reference_caption.set_visible(false)
            ui.reference_image.set_visible(false)
        }
    }
    if m == 3 { refresh_plan() }
    if m == 4 { refresh_export() }
}

fn env_kind(){
    if is_hosted_octosense() { return "octosense" }
    if is_hosted_rinx() { return "rinx" }
    return "card-host"
}

// In hosted OctoSense / Rinx, the agent/AI host services are wired in by
// the shell (kernel + llm + model). In card-host, services are declared by
// the manifest but never connected, so a positive "available" probe is
// misleading — every AI call is a real test. We render the status label to
// reflect what was actually reachable at boot, with a follow-up detail the
// user can verify at the OctoSense shell for the real experience.
fn boot(){
    load_works()
    rebuild_known_tags()
    let model_decl = host.has("model")
    let octos_decl = host.has("octos.turn.start")
    // Trust the declaration, but always expose the real runtime so the
    // user knows whether calls actually work. cardhost CLI never wires
    // a real provider, so anything not in (OctoSense shell, Rinx mini-app)
    // will not see a real AI answer.
    let k = env_kind()
    if k == "card-host" {
        status_text = "card-host · AI 仅声明,未连接"
        status_detail = "card-host CLI 不连接 octos 助手与模型服务,所有 AI 调用实际不可用(界面只反映 manifest 声明)。文本、样式、导出、保存等手动能力完整;在 OctoSense 桌面壳或 Rinx 中运行可获得真实 octos 二创与 9 场景生成(见 INTEGRATION.md)。"
    } else if model_decl && octos_decl {
        status_text = k + " · octos + model 已就绪"
        status_detail = "在" + k + " 中由本机 octos 内核提供 AI:原文 8 风格二创,9 场景结构化生成(PPT/拆解/口播/导图/金句/拆解模板),导出 Markdown / 公众号 / Notion / Marp / SRT / 制作包 / markmap。AI 响应受宿主实现影响(OctoSense#327 / Rinx#63 已记录异步回复缺口)。"
    } else if octos_decl {
        status_text = k + " · octos 已就绪(model 缺)"
        status_detail = "octos 二创可走;场景生成(model 缺)会降级为演示内容。检查宿主" + k + " 设置 → AI providers。"
    } else {
        status_text = k + " · AI 未连接"
        status_detail = "当前宿主未授予 octos / model 服务。可手动创作、编辑、导出;在" + k + " 中启用 AI provider 后重启宿主即可获得 AI 能力。"
    }
    ui.status.set_text(status_text)
    ui.status_detail.set_text(status_detail)
    ui.tag_row.render()
    ui.works_list.render()
    goto(0)
}

// Stubs: card-host CLI / Card runner / Rinx mini-app surface return false.
// OctoSense shell sets env OCTOSENSE_APP_ID or similar — we sniff it.
fn is_hosted_octosense(){
    return host.has("octos.system") || host.has("os.notification")
}
fn is_hosted_rinx(){
    return host.has("rinx.event")
}

start_timeout(0.05, || boot())

root := SolidView{width: Fill height: Fill flow: Down padding: 16 spacing: 10 draw_bg.color: #xfffaf5
    View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
        Label{text: "OctoStudio" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 26}}
        status := Label{width: Fill text: status_text draw_text.color: secondary draw_text.text_style.font_size: 10}
    }
    status_detail := Label{width: Fill text: status_detail draw_text.color: secondary draw_text.text_style.font_size: 9}
    tabs := View{width: Fill height: Fit flow: Right spacing: 6 on_render: || {
        let labels = ["广场" "录入" "工坊" "计划" "导出"]
        for i in 5 {
            let label = labels[i]
            ButtonFlat{text: label height: 32 padding: Inset{left: 14 right: 14}
                on_click: || goto(i)
                draw_bg +: {color: (if mode == i {accent} else {chip_bg}) color_hover: (if mode == i {#xff8866} else {warm_hover}) border_radius: 16.0 border_size: 0.0}
                draw_text +: {color: (if mode == i {#xffffff} else {ink}) color_hover: (if mode == i {#xffffff} else {ink})}}
        }
    }}

    content := View{width: Fill height: Fill flow: Overlay

        home_view := ScrollYView{width: Fill height: Fill flow: Down spacing: 10 visible: (mode == 0)
            Label{width: Fill text: "创作广场" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 20}}
            View{width: Fill height: Fit flow: Right spacing: 6
                for i in 5 {
                    let sc = SCENARIOS[i]
                    GestureView{width: 71 height: Fit flow: Down spacing: 2 padding: Inset{top: 8 bottom: 8 left: 6 right: 6}
                        draw_bg +: {color: #xffffff color_hover: card_bg border_radius: 10.0 border_size: 0.0}
                        on_tap: || start_scenario(sc["id"])
                        Label{width: Fill text: sc["emoji"] draw_text.text_style.font_size: 17}
                        Label{width: Fill text: sc["name"] draw_text.color: ink draw_text.text_style.font_size: 11}
                        Label{width: Fill text: sc["hint"] draw_text.color: secondary draw_text.text_style.font_size: 7}
                    }
                }
            }
            View{width: Fill height: Fit flow: Right spacing: 6
                for i in 5 {
                    let j = i + 5
                    let sc = SCENARIOS[j]
                    GestureView{width: 71 height: Fit flow: Down spacing: 2 padding: Inset{top: 8 bottom: 8 left: 6 right: 6}
                        draw_bg +: {color: #xffffff color_hover: card_bg border_radius: 10.0 border_size: 0.0}
                        on_tap: || start_scenario(sc["id"])
                        Label{width: Fill text: sc["emoji"] draw_text.text_style.font_size: 17}
                        Label{width: Fill text: sc["name"] draw_text.color: ink draw_text.text_style.font_size: 11}
                        Label{width: Fill text: sc["hint"] draw_text.color: secondary draw_text.text_style.font_size: 7}
                    }
                }
            }
            Label{width: Fill text: "本地创作工作台 · 一句话生成图文/分镜/PPT/口播等,导出至公众号 / Markdown / Notion / Marp。长按卡片删除。" draw_text.color: secondary draw_text.text_style.font_size: 11}
            View{width: Fill height: Fit flow: Right spacing: 6 align: Align{y: 0.5}
                search_input := TextInput{width: Fill height: 32 empty_text: "搜索作品标题 / 原文关键词…"
                    draw_bg +: {color: #xffffff color_hover: #xffffff color_focus: #xffffff color_empty: #xf5e6d2 border_radius: 8.0}
                    draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: secondary color_empty_hover: secondary}
                    on_change: |t| set_search(t)}
                ButtonFlat{text: "清除" height: 30 padding: Inset{left: 10 right: 10} on_click: || { set_search(""); ui.search_input.set_text("") }
                    draw_bg +: {color: chip_bg color_hover: warm_hover border_radius: 15.0 border_size: 0.0}
                    draw_text +: {color: ink color_hover: ink}
                    draw_text.text_style.font_size: 10}
            }
            works_list := View{width: Fill height: Fit flow: Down spacing: 10 on_render: || {
                let visible = filtered_works()
                if visible.len() == 0 {
                    View{width: Fill height: 140 align: Align{x: 0.5 y: 0.5}
                        Label{text: (if works.len() == 0 {"还没有作品"} else {"没有匹配的作品"}) draw_text.color: ink draw_text.text_style.font_size: 15}
                        Label{text: (if works.len() == 0 {"点上面的场景卡片开始一段创作。"} else {"清除搜索 / 标签筛选看全部。"}) draw_text.color: secondary draw_text.text_style.font_size: 12}
                    }
                }
                for i in 24 {
                    if i < visible.len() {
                    let w = visible[i]
                    let title_v = (if w["title"] != nil {w["title"]} else {"未命名作品"})
                    let kind_v = (if w["plan_kind"] != nil {w["plan_kind"]} else {""})
                    let style_v = (if w["style"] != nil {w["style"]} else {"改写"})
                    let stamp_v = (if w["updated"] != nil {w["updated"]} else {0})
                    let sub = style_v
                    if kind_v != "" { sub = kind_name(kind_v) }
                    let tags_arr = (if w["tags"] != nil {w["tags"]} else {[]})
                    let hist_arr = (if w["history"] != nil {w["history"]} else {[]})
                    GestureView{width: Fill height: Fit flow: Down spacing: 4 padding: Inset{top: 12 bottom: 12 left: 14 right: 14}
                        draw_bg +: {color: #xffffff color_hover: card_bg border_radius: 10.0 border_size: 0.0}
                        on_tap: |x, y| open_work(w["id"])
                        on_long_press: |x, y| delete_work(w["id"])
                        View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                            Label{width: Fill text: title_v draw_text.color: ink draw_text.text_style.font_size: 17}
                            Label{text: kind_emoji(kind_v) draw_text.color: secondary draw_text.text_style.font_size: 14}
                        }
                        Label{width: Fill text: (sub + " · 更新于 " + rel_time(stamp_v)) draw_text.color: secondary draw_text.text_style.font_size: 11}
                        if tags_arr.len() > 0 {
                            View{width: Fill height: Fit flow: Right spacing: 4
                                for ti in 6 {
                                    if ti < tags_arr.len() {
