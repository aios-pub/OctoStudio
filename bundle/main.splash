                                    draw_text +: {color: ink color_hover: ink}
                                    draw_text.text_style.font_size: 9}
                            }
                            if history_open_id == w["id"] {
                                View{width: Fill height: Fit flow: Down spacing: 2 padding: Inset{left: 6 right: 6 top: 4 bottom: 4}
                                    draw_bg +: {color: #xfafafa color_hover: #xfafafa border_radius: 6.0 border_size: 0.0}
                                    Label{width: Fill text: history_lines(hist_arr) draw_text.color: ink draw_text.text_style.font_size: 10}
                                }
                            }
                        }
                    }
                    }
                }
            }}
            tag_row := View{width: Fill height: Fit flow: Right spacing: 4 on_render: || {
                let label = "#全部"
                ButtonFlat{text: label height: 24 padding: Inset{left: 8 right: 8}
                    on_click: || toggle_tag("")
                    draw_bg +: {color: (if active_tag == "" {accent} else {chip_bg}) color_hover: (if active_tag == "" {#xff8866} else {warm_hover}) border_radius: 12.0 border_size: 0.0}
                    draw_text +: {color: (if active_tag == "" {#xffffff} else {secondary}) color_hover: (if active_tag == "" {#xffffff} else {ink})}
                    draw_text.text_style.font_size: 9}
                if known_tags.len() == 0 {
                    Label{text: "(尚无标签,完成作品后自动出现)" draw_text.color: secondary draw_text.text_style.font_size: 9}
                }
                for k in 16 {
                    if k < known_tags.len() {
                        let tg = known_tags[k]
                        let lbl = "#" + tg
                        ButtonFlat{text: lbl height: 24 padding: Inset{left: 8 right: 8}
                            on_click: || toggle_tag(tg)
                            draw_bg +: {color: (if active_tag == tg {accent} else {chip_bg}) color_hover: (if active_tag == tg {#xff8866} else {warm_hover}) border_radius: 12.0 border_size: 0.0}
                            draw_text +: {color: (if active_tag == tg {#xffffff} else {secondary}) color_hover: (if active_tag == tg {#xffffff} else {ink})}
                            draw_text.text_style.font_size: 9}
                    }
                }
            }}
        }

        compose_view := View{width: Fill height: Fill flow: Down spacing: 10 visible: (mode == 1)
            Label{text: "录入" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 20}}
