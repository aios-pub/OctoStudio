let ink = #x1c1c1e
let secondary = #x8e8e93
let accent = #xff6b35
let warm_hover = #xeadcd0
let card_bg = #xfff5ec
let chip_bg = #xf5e6dd
let danger = #xb3541e

fn bump_seq(){
    seq += 1
    return seq
}

fn new_id(){
    return "w-" + bump_seq().to_string()
}

fn now_label(){
    return "#" + bump_seq().to_string()
}

// host.request 的回调在慢响应(>60s)时会被桥的超时丢弃;70 秒看门狗兜底复位,
// 让用户可以立刻重试(状态栏明示),而不是永远停在"生成中"。
fn arm_watchdog(){
    if gen_timer != nil { stop_timer(gen_timer) }
    gen_timer = start_timeout(70.0, || {
        if busy {
            busy = false
            status_text = "AI 响应超时(>70 秒),已复位 — 请再点一次生成"
            ui.status.set_text(status_text)
            ui.generate_btn.set_text(gen_label(plan_kind))
        }
    })
}

fn disarm_watchdog(){
    if gen_timer != nil { stop_timer(gen_timer) }
}

fn sval(v){
    if v == nil { return "" }
    return v.to_string()
}

fn rel_time(stamp){
    if stamp == nil { return "刚刚" }
    let d = seq - stamp
    if d <= 2 { return "刚刚" }
    if d < 30 { return "" + d.to_string() + " 步前" }
    if d < 200 { return "" + (d / 10).to_string() + " 分钟前" }
    return "" + (d / 50).to_string() + " 小时前"
}

fn word_count(s){
    if s == nil { return 0 }
    if s == "" { return 0 }
    return s.len()
}

// 时长等数值可能来自模型(整数)或手动编辑(字符串),统一转成整数秒。
fn dur_int(v){
    let dv = 5.0
    if v != nil { dv = v.to_string().to_f64() }
    if dv >= 600.0 { return 600 }
    let n = 0
    let rem = dv
    for k in 600 {
        if rem >= 1.0 { rem = rem - 1.0; n = n + 1 }
    }
    if n < 1 { return 5 }
    return n
}

fn pad2(n){
    if n < 10 { return "0" + n.to_string() }
    return n.to_string()
}

fn srt_time(t){
    let h = 0
    let rem = t
    for k in 12 {
        if rem >= 3600 { rem = rem - 3600; h = h + 1 }
    }
    let m = 0
    for k in 60 {
        if rem >= 60 { rem = rem - 60; m = m + 1 }
    }
    return pad2(h) + ":" + pad2(m) + ":" + pad2(rem) + ",000"
}

