                            draw_bg +: {color: (if current_preset == p["id"] {accent} else {chip_bg}) color_hover: (if current_preset == p["id"] {#xff8866} else {warm_hover}) border_radius: 13.0 border_size: 0.0}
                            draw_text +: {color: (if current_preset == p["id"] {#xffffff} else {secondary}) color_hover: (if current_preset == p["id"] {#xffffff} else {ink}) }
