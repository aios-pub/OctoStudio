fn scenario_cfg(kind){
    if kind == "" { return {intent: false source: true theme: false} }
    if kind == "teardown" { return {intent: false source: true theme: false} }
    if kind == "titles" { return {intent: true source: true theme: false} }
    if kind == "mindmap" { return {intent: true source: true theme: false} }
    if kind == "image" { return {intent: true source: false theme: true} }
    if kind == "ppt" { return {intent: true source: false theme: true} }
    if kind == "xhs" { return {intent: true source: false theme: true} }
    if kind == "script" { return {intent: true source: false theme: true} }
    return {intent: true source: false theme: false}
}

fn kind_name(kind){
    for sc in SCENARIOS {
        if sc["id"] == kind { return sc["name"] }
    }
    return "原文二创"
}

fn kind_emoji(kind){
    for sc in SCENARIOS {
        if sc["id"] == kind { return sc["emoji"] }
    }
    return "📝"
}

fn gen_label(kind){
    if kind == "image" { return "生成图文" }
    if kind == "video" { return "生成分镜" }
    if kind == "ppt" { return "生成 PPT" }
    if kind == "teardown" { return "开始拆解" }
    if kind == "titles" { return "生成标题" }
    if kind == "xhs" { return "生成笔记" }
    if kind == "script" { return "生成口播稿" }
    if kind == "mindmap" { return "生成导图" }
    if kind == "quotes" { return "生成金句" }
    return "进入创作"
}

fn gen_status(kind){
    if kind == "image" { return "生成图文大纲中…" }
    if kind == "video" { return "生成分镜中…" }
    if kind == "ppt" { return "生成 PPT 大纲中…" }
    if kind == "teardown" { return "拆解视频中…" }
    if kind == "titles" { return "生成标题中…" }
    if kind == "xhs" { return "生成笔记中…" }
    if kind == "script" { return "生成口播稿中…" }
    if kind == "mindmap" { return "生成导图中…" }
    if kind == "quotes" { return "生成金句中…" }
    return "创作中…"
}

fn kind_done_note(kind){
    let n = current_plan_items.len().to_string()
    if kind == "video" { return "分镜已就绪 · " + n + " 镜 · " + now_label() }
    if kind == "ppt" { return "PPT 已就绪 · " + n + " 页 · " + now_label() }
    if kind == "teardown" { return "拆解报告已就绪 · " + n + " 条 · " + now_label() }
    if kind == "titles" { return "候选标题已就绪 · " + n + " 个 · " + now_label() }
    if kind == "xhs" { return "小红书笔记已就绪 · " + now_label() }
    if kind == "script" { return "口播稿已就绪 · " + n + " 拍 · " + now_label() }
    if kind == "mindmap" { return "导图大纲已就绪 · " + n + " 个分支 · " + now_label() }
    if kind == "quotes" { return "金句已就绪 · " + n + " 条 · " + now_label() }
    return "图文 plan 已就绪 · " + n + " 段 · " + now_label()
}

fn compose_hint(kind){
    if kind == "" { return "可粘贴原文,或填写参考图 URL,进入工坊做 AI 二创。" }
    if kind == "image" { return "一句话描述想写的图文(如:夏日海边慢生活,温暖散文风),AI 生成可编辑大纲与配图 prompt。" }
    if kind == "video" { return "一句话描述视频,AI 生成 4-6 镜分镜:时长/景别/画面/配音/生视频 prompt。" }
    if kind == "ppt" { return "一句话描述演示主题,AI 生成 5-10 页大纲,可导出 Marp。" }
    if kind == "teardown" { return "在下方粘贴爆款视频的文字稿/字幕/或详细描述,AI 拆解结构、钩子、镜头语言与可复用骨架。" }
    if kind == "titles" { return "给主题一句话,或粘贴原文,AI 生成 8 个候选标题并打分。" }
    if kind == "xhs" { return "一句话描述笔记主题,AI 生成标题/正文/标签/配图 prompt。" }
    if kind == "script" { return "一句话描述口播主题,AI 生成钩子/节拍/CTA。" }
    if kind == "mindmap" { return "给主题一句话,或粘贴原文,AI 生成导图大纲,可导 markmap。" }
    if kind == "quotes" { return "一句话给主题,AI 生成 8 条金句与适用场景。" }
    return "一句话意图,AI 生成可编辑的结构化内容。"
}

fn plan_hint(kind){
    if kind == "image" { return "每段可编辑(增删改排),配图 prompt 可复制到外部生图工具。" }
    if kind == "video" { return "每镜可编辑;下方可生成 AI 合成建议;导出页有 SRT 字幕与制作包。" }
    if kind == "ppt" { return "每页可编辑增删重排;导出 Marp 粘到 marp.app 即成演示。" }
    if kind == "teardown" { return "每条可编辑;「存为分镜模板」把复用骨架变成新视频意图。" }
    if kind == "titles" { return "候选标题可编辑;推荐指数 1-100。" }
    if kind == "xhs" { return "标题/正文/配图 prompt 都可编辑。" }
    if kind == "script" { return "钩子/节拍/CTA 可编辑,按序口播即可。" }
    if kind == "mindmap" { return "分支与子节点(分号分隔)可编辑;导出 markmap 生成导图。" }
    if kind == "quotes" { return "金句与适用场景可编辑。" }
    return "内容可编辑,保存后进作品库。"
}

fn kind_formats(kind){
    if kind == "video" {
        return [{id: "markdown" label: "Markdown"} {id: "wechat" label: "公众号"} {id: "notion" label: "Notion"} {id: "srt" label: "SRT字幕"} {id: "pack" label: "制作包"}]
    }
    if kind == "ppt" {
        return [{id: "marp" label: "Marp"} {id: "markdown" label: "大纲"} {id: "notion" label: "Notion"}]
    }
    if kind == "mindmap" {
        return [{id: "markdown" label: "Markdown"} {id: "markmap" label: "markmap"} {id: "wechat" label: "公众号"}]
    }
    if kind == "xhs" {
        return [{id: "markdown" label: "Markdown"} {id: "wechat" label: "小红书正文"} {id: "notion" label: "Notion"}]
    }
    return [{id: "markdown" label: "Markdown"} {id: "wechat" label: "公众号"} {id: "notion" label: "Notion"}]
}

fn format_hint(id){
    if id == "srt" { return "全选复制,保存为 subtitle.srt(UTF-8),放视频同目录。" }
    if id == "pack" { return "视频制作包:逐镜 prompt + SRT + 合成建议 + ffmpeg 命令,照做即可成片。" }
    if id == "marp" { return "全选复制,粘到 marp.app 或 VSCode Marp 插件即可放映/导出 PDF。" }
    if id == "markmap" { return "全选复制,粘到 markmap.js.org/repl 生成导图。" }
    if id == "wechat" { return "纯文本无标记,直接粘进公众号/小红书编辑器。" }
    if id == "notion" { return "Markdown 格式,粘进 Notion 自动转换。" }
    return "全选下面文本 → 复制,粘到目标平台。"
}

fn item_fields(kind){
    if kind == "image" {
        return [{key: "heading" label: "段落标题" multi: false} {key: "body" label: "正文" multi: true} {key: "image_prompt" label: "生图 prompt" multi: true}]
    }
    if kind == "video" {
        return [{key: "id" label: "镜号" multi: false} {key: "duration_s" label: "时长(秒)" multi: false} {key: "shot_type" label: "景别" multi: false} {key: "description" label: "画面描述" multi: true} {key: "voiceover" label: "配音文案" multi: true} {key: "video_prompt" label: "生视频 prompt" multi: true}]
    }
    if kind == "ppt" {
        return [{key: "kind" label: "类型(cover/agenda/content/quote/end)" multi: false} {key: "title" label: "页标题" multi: false} {key: "bullets_text" label: "要点(分号分隔)" multi: false} {key: "notes" label: "讲稿" multi: true} {key: "visual_prompt" label: "配图 prompt" multi: true}]
    }
    if kind == "titles" {
        return [{key: "text" label: "标题" multi: false} {key: "style_tag" label: "风格" multi: false} {key: "score" label: "推荐指数(1-100)" multi: false}]
    }
    if kind == "xhs" {
        return [{key: "heading" label: "配图位" multi: false} {key: "body" label: "生图 prompt" multi: true}]
    }
    return [{key: "label" label: "标签" multi: false} {key: "text" label: "内容" multi: true}]
}

fn blank_item(kind){
    if kind == "image" { return {heading: "新段落" body: "" image_prompt: ""} }
    if kind == "video" {
        let n = current_plan_items.len() + 1
        return {id: "S" + n.to_string() duration_s: 5 shot_type: "中景" description: "" voiceover: "" video_prompt: ""}
    }
    if kind == "ppt" { return {kind: "content" title: "新页" bullets_text: "" notes: "" visual_prompt: ""} }
    if kind == "titles" { return {text: "新标题" style_tag: "通用" score: 80} }
    if kind == "xhs" { return {heading: "配图 prompt" body: "" _k: bump_seq()} }
    return {label: "新条目" text: "" _k: bump_seq()}
}

fn img_w(kind){
    if kind == "xhs" { return 576 }
    return 768
}

fn img_h(kind){
    if kind == "xhs" { return 720 }
    if kind == "image" { return 512 }
    return 432
}

fn img_prompt_of(kind, it){
    if kind == "image" { return sval(it["image_prompt"]) }
    if kind == "video" { return sval(it["video_prompt"]) }
    if kind == "ppt" { return sval(it["visual_prompt"]) }
    if kind == "xhs" { return sval(it["body"]) }
    return ""
}

fn seed_of(it){
    let k = it["_k"]
    if k == nil { return 1 }
    return k
}

fn img_url(p, w, h, seed){
    return "https://image.pollinations.ai/prompt/" + p.url_encode() + "?width=" + w.to_string() + "&height=" + h.to_string() + "&seed=" + seed.to_string() + "&nologo=true"
}

fn theme_prompt(){
    for th in THEMES {
        if th["id"] == current_theme {
            if th["id"] == "" { return "" }
            return " 写作主题风格:" + th["tone"]
        }
    }
    return ""
}

fn preset_line(){
    for p in PRESETS {
        if p["id"] == current_preset {
            if p["id"] == "" { return "" }
            return p["name"] + "(" + p["desc"] + ")"
        }
    }
    return ""
}

