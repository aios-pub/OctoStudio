                    }
                }}
            }
            compose_hint := Label{width: Fill text: "" draw_text.color: secondary draw_text.text_style.font_size: 11}
            reference_label := Label{width: Fill text: "参考图 URL(可选)" draw_text.color: secondary draw_text.text_style.font_size: 10}
            reference_input := TextInput{width: Fill height: 36 empty_text: "https://example.com/cover.jpg"
                draw_bg +: {color: #xffffff color_hover: #xffffff color_focus: #xffffff color_empty: #xf5e6d2 border_radius: 8.0}
                draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: secondary color_empty_hover: secondary}}
